--- !u!114 &1803325470
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1803325468}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91e8eefd99613694595538f0c2578205, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  infos:
  - "\u94F6\u6CB3\u7CFB  \u76FE\u724C-\u534A\u4EBA\u9A6C\u5EA7\u60AC\u81C2  \u8D6B\u5361\u5FD2\u661F\u533A 
    \u70BD\u661F\u661F\u7CFB  \u67EF\u4F0A\u4F2F\u5E26"
  - "30\u4E2A\u5730\u7403\u5E74\u524D, \u6211\u7684\u7956\u5148, \u84DD\u8272\u7A7A\u95F4\u53F7\u4E0A\u7684\u4EBA\u7C7B\u4E0E\u5176\u4ED6\u8230\u961F\u7206\u53D1\u4E86\u9ED1\u6697\u68EE\u7ACB\u6218\u5F79"
  - "\u6211\u4EEC\u53D7\u5230\u4E86\u5730\u7403\u4EBA\u7C7B\u8054\u5408\u4E09\u4F53\u4EBA\u7684\u80CC\u53DB,
    \u4ECE\u6B64\u53CD\u76EE\u6210\u4EC7"
  - "\u6218\u4E89\u7ED3\u675F\u540E, \u84DD\u8272\u7A7A\u95F4\u53F7\u79BB\u5F00\u4E86\u5730\u7403,
    \u79BB\u5F00\u4E86\u592A\u9633\u7CFB, \u5F00\u59CB\u4E86\u6F2B\u65E0\u76EE\u7684\u7684\u6F02\u6CCA"
  - "\u6211\u4EEC\u79F0\u81EA\u5DF1\u4E3A\u94F6\u6CB3\u7CFB\u4EBA\u7C7B, \u4EE5\u6B64\u4E0E\u5730\u7403\u4EBA\u7C7B\u4F5C\u4E3A\u5212\u5206"
  - "\u6211\u4EEC\u518D\u4E5F\u6CA1\u6709\u4E86\u9000\u8DEF, \u8FD9\u65B9\u5BF8\u7684\u94A2\u7B4B\u571F\u5730\u5C31\u662F\u6211\u4EEC\u552F\u4E00\u7684\u5BB6"
  - "10\u4E2A\u5730\u7403\u5E74\u524D, \u6211\u4EEC\u62B5\u8FBE\u4E86\u534A\u4EBA\u9A6C\u5EA7\u7684\u70BD\u661F\u661F\u7CFB\u8865\u5145\u8D44\u6E90"
  - "\u70BD\u661F\u5F88\u7F8E, \u5374\u4E5F\u5F88\u5371\u9669"
  - "\u6052\u661F\u98CE\u7684\u6C14\u65CB\u5E26\u6765\u4E86\u6C14\u6001\u8D44\u6E90,
    \u4E5F\u53C8\u53D1\u4E86\u9AD8\u5F3A\u5EA6\u7684\u8F90\u5C04"
  - "\u6211\u7684\u5BB6\u5EAD\u4E5F\u56E0\u6B64\u652F\u79BB\u7834\u788E"
  - "\u6211\u7684\u5988\u5988\u5C31\u662F\u6B7B\u4E8E\u4E00\u573A\u6052\u661F\u98CE\u66B4\u5F15\u8D77\u7684\u795E\u7ECF\u75BE\u75C5"
  - "\u7238\u7238\u4E5F\u5728\u4E00\u6B21\u5916\u51FA\u63A2\u7D22\u4EFB\u52A1\u4E2D,
    \u4E0D\u77E5\u8E2A\u8FF9"
  - "\u6709\u4EBA\u8BF4, \u4ED6\u7684\u8239\u6401\u6D45\u5728\u4E86\u4E00\u4E2A\u8352\u661F\u4E0A"
  - "\u4E5F\u6709\u4EBA\u8BF4, \u4ED6\u80CC\u53DB\u4E86\u6211\u4EEC, \u5C48\u670D\u4E8E\u6076\u52A3\u7684\u73AF\u5883,
    \u9003\u56DE\u4E86\u5730\u7403"
  - "\u800C\u6211, \u5374\u88AB\u7559\u5728\u4E86\u8FD9\u91CC"
  - "\u8001\u5E08\u8BF4, \u5730\u7403\u5DF2\u7ECF\u88AB\u6BC1\u706D\u4E86"
