  m_text: "\u5BB6\u5C5E\u540C\u5FD7:\n        \u5F88\u9057\u61BE\u7684\u901A\u77E5\u60A8
    , \u8587\u8587\u5B89\xB7\u6768\u7684\u8F90\u5C04\u75C5\u60C5\u51B5\u4E0D\u4E50\u89C2,
    \u4FDD\u5B88\u4F30\u8BA1\u53EA\u6709\u56DB\u4E2A\u6708\u7684\u751F\u547D\u65F6\u5149\n\n       
    \u7531\u4E8E\u8FD1\u671F\u661F\u8230\u5185\u90E8\"\u56DE\u5230\u84DD\u661F\u201D\u601D\u6F6E\u6108\u53D1\u76DB\u884C,
    \u52A0\u4E0A\u4E24\u9897\u6C14\u6001\u6052\u661F\u4E0E\u5CA9\u77F3\u884C\u661F\u5E26\u5E26\u6765\u7684\u77FF\u77F3\u98CE\u66B4\u6108\u53D1\u4E25\u91CD\uFF0C\u8D8A\u6765\u8D8A\u591A\u7684\u75C5\u4EBA
    \u65E0\u6CD5\u5F97\u5230\u533B\u6CBB, \u4E00\u4E9B\u5E72\u5458\u751A\u81F3\u5728\u672A\u6709\u9884\u5146\u7684\u60C5\u51B5\u4E0B\u53D1\u4F5C...\n\n      
    \u4F60\u4E5F\u77E5\u9053, \u8F90\u5C04\u75C5\u5BF9\u7CBE\u795E\u6709\u5F88\u5927\u635F\u4F24,
    \u60A3\u8005\u5F88\u53EF\u80FD\u5728\u65E0\u610F\u8BC6\u7684\u60C5\u51B5\u4E0B\u4F24\u5BB3\u522B\u4EBA
    , \u8BF7\u60A8\u8FD1\u671F\u4E00\u5B9A\u8981\u968F\u8EAB\u643A\u5E26\u9547\u5B9A\u67AA...\n\n       
    \u53E6\u5916\u5982\u679C\u9700\u8981, \u6211\u4EEC\u6709\u4E2A\u8F90\u5C04\u75C5\u7684\u75C5\u53CB\u8BBA\u575B,
    \u867D\u7136\u4E0D\u4E00\u5B9A\u5BF9\u60A8\u7684\u59BB\u5B50\u6709\u4EC0\u4E48\u5E2E\u52A9, 
    \u81F3\u5C11\u4F1A\u8BA9\u60A8\u7684\u8EAB\u5FC3\u6709\u6240\u5BBD\u6170...\n\n       
    \u8BBA\u575B\u7684ID\u662F6789412, \u5982\u679C\u60A8\u65E0\u6CD5\u8BA4\u8BC1,
    \u53EF\u4EE5\u627E0\u5C42\u7684\u770B\u5B88\u5458\u8001\u4F19\u8BA1\u4F0A\u4E07\u5E2E\u5FD9...\n                                               
    \n\n                                                      \u5B89\u5B9A\u5BA45\u53F7\u503C\u73ED\u5458\n                                                      
    \u5361\u7279 \xB7 \u5BDF\u5C14\u68EE \u656C\u793C\n"
  m_isRightToLeft: 0
