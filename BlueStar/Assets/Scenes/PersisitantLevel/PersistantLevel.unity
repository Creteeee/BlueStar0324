    - target: {fileID: 3490908453261379966, guid: 84efd093f195c8844bbe685f19ebc60a,
        type: 3}
      propertyPath: m_text
      value: "\u70BD\u661F\u662F\u4E00\u9897\u5E74\u8F7B\u7684 \u201C O\u578B \u201D
        \u84DD\u8272\u6052\u661F, \u5468\u56F4\u8FD1\u5904\u73AF\u7ED5\u77400.2\u4E2A\u6052\u661F\u5BBD\u7684\u788E\u77F3\u5E26,
        \u70BD\u661F\u5F02\u5E38\u6D3B\u8DC3\u7684\u6052\u661F\u98CE, \u901A\u8FC7\u4E0E\u8FD9\u4E9B\u788E\u77F3\u76F8\u4E92\u4F5C\u7528,
        \u4F1A\u5BF9\u5728\u5916\u4F5C\u4E1A, \u6CA1\u6709\u5F97\u5230\u59A5\u5584\u9632\u5FA1\u7684\u661F\u8230\u516C\u6C11\u9020\u6210\u795E\u7ECF\u6BD2\u7D20\u7684\u635F\u4F24\n\n
        \u867D\u7136\u661F\u8230\u56FD\u9645\u5DF2\u7ECF\u7814\u5236\u51FA\u4E86\u7279\u6548\u836F,
        \u4F46\u662F\u8FC7\u91CF\u7684\u6BD2\u7D20\u8FD8\u662F\u4F1A\u8FC5\u901F\u5BF9\u795E\u7ECF\u5143\u4EA7\u751F\u4F24\u5BB3,
        \u4E25\u91CD\u65F6\u4F1A\u4F7F\u60A3\u8005\u8FDB\u5165\u72C2\u8E81\u72B6\u6001......\n\n\u56E0\u6B64,
        \u77FF\u77F3\u75C7\u7684\u8BC6\u522B, \u9884\u9632\u4E0E\u6CBB\u7597\u53D8\u5F97\u5C24\u4E3A\u91CD\u8981......"
