    - target: {fileID: 3490908453261379966, guid: 84efd093f195c8844bbe685f19ebc60a,
        type: 3}
      propertyPath: m_text
      value: "1.1 \u8F7B\u5EA6\n\u5C11\u91CF\u77FF\u77F3\u5C18\u7531\u76AE\u80A4\u4FB5\u5165,
        \u7ECF\u7531\u5FAA\u73AF\u7CFB\u7EDF, \u8FDB\u5165\u5927\u8111\u76AE\u5C42,
        \u8FD9\u4E2A\u9636\u6BB5\u7531\u4E8E\u6BD2\u7D20\u542B\u91CF\u4E0D\u9AD8,
        \u56E0\u6B64\u5927\u90E8\u53EF\u4EE5\u88AB\u4EBA\u4F53\u4EE3\u8C22\u6389,
        \u60A3\u8005\u4EC5\u4F1A\u611F\u5230\u4E00\u70B9\u7729\u6655\n\n1.2 \u4E2D\u5EA6\n\u591A\u4F59\u7684\u77FF\u77F3\u6BD2\u7D20\u65E0\u6CD5\u53CA\u65F6\u88AB\u4EE3\u8C22,
        \u5C06\u4F1A\u4FB5\u5165\u8111\u5E72, \u5F71\u54CD\u60A3\u8005\u7684\u547C\u5438\u548C\u884C\u52A8,
        \u540C\u65F6\u4F1A\u5728\u76AE\u80A4\u8868\u5C42\u4EA7\u751F\u7EFF\u8272\u7684\u9709\u6591, 
        \u82E5\u4E0D\u6CBB\u7597,\u75C5\u75C7\u4F1A\u8FDB\u5165\u6B7B\u4EA1\n\n1.3
        \u91CD\u5EA6\n\u5982\u679C\u5728\u6781\u77ED\u65F6\u95F4\u5185\u6444\u5165\u5DE8\u91CF\u77FF\u77F3\u5C18,
        \u77FF\u77F3\u5C18\u5C06\u4FB5\u5165\u795E\u7ECF\u4E2D\u67A2, \u60A3\u8005\u4F1A\u4EA7\u751F\u5E7B\u89C9,
        \u8FDB\u5165\u72C2\u8E81\u72B6\u6001, \u5BF9\u5176\u4ED6\u516C\u6C11\u4EA7\u751F\u4F24\u5BB3,
        \u9700\u53CA\u65F6\u6CE8\u5C04\u6216\u8005\u66B4\u9732\u5728\u9547\u5B9A\u55B7\u96FE\n"
