  m_text: "\u8DDD\u79BB\u5371\u673A\u7EAA\u5143\u5DF2\u7ECF\u8FC7\u53BB\u4E86\u5341\u5E74\n\u518D\u8FC7\u4E00\u4E9B\u65F6\u65E5,
    \u6211\u5C31\u8981\u5FD8\u8BB0\u592A\u9633\u7CFB\u7684\u6A21\u6837......\n\n\u5728\u865A\u7A7A\u4E2D\u7684\u65E5\u5B50,
    \u603B\u8BA9\u6211\u89C9\u5F97\u4EBA\u751F\u7684\u524D\u4E00\u534A\u662F\u4E0D\u771F\u5B9E\u7684,
    \u6211\u65E0\u6570\u6B21\u68A6\u5230\u66FE\u7ECF\u7AD9\u5728\u5927\u5730\u4E0A,
    \u611F\u53D7\u5230\u7684\u548C\u7166\u7684\u9633\u5149\n\n\u597D\u5728\u8FD8\u6709\u4F0A\u8FBE,
    \u6211\u4EEC\u7684\u5B69\u5B50\u4E5F\u5FEB\u8981\u51FA\u751F\u4E86,\u6211\u5C06\u7ED9\u4ED6\u53D6\u540D\u4E3A\u6CF0\u62C9,
    \u5730\u7403\u7684\u540D\u5B57......\n\u6216\u8BB8\u6211\u5E94\u8BE5\u63A5\u53D7\u81EA\u5DF1\u7684\u547D\u8FD0,
    \u4E3A\u94F6\u6CB3\u7CFB\u4EBA\u7C7B\u7684\u672A\u6765\u8BA9\u6B65"
